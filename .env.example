# Copy this file to .env and paste your key after the equals sign.
# Create a key at: https://aistudio.google.com/app/apikey
#
# Browser Use reads GOOGLE_API_KEY. This project also accepts GEMINI_API_KEY
# and copies it to GOOGLE_API_KEY automatically.

GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional
GEMINI_MODEL=gemini-2.5-flash
AGENT_MAX_STEPS=15
AGENT_MAX_RETRIES=2
AGENT_TASK_TIMEOUT=600
AGENT_VERBOSE=false
AGENT_MEMORY_ENABLED=true
BROWSER_USE_HEADLESS=false

# Optional Telegram notifications for the job-hunting agent
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Job discovery (true/false)
JOB_DISCOVERY_NETWORK=true

# Browser agent LLM provider: groq (recommended, fastest), openrouter, or gemini
LLM_PROVIDER=groq
FALLBACK_PROVIDER=openrouter
TERTIARY_PROVIDER=gemini

# Groq — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter — get a key at https://openrouter.ai/keys
# OPENROUTER_MODEL must be a chat/instruct model, never an embedding model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free

